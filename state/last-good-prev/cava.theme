; cava colour theme -- generated by matugen. Do not edit by hand.
;
; A recreation of catppuccin/cava's gradient theme
; (github.com/catppuccin/cava, themes/mocha-transparent.cava) in this
; desktop's own wallpaper-derived colours.
;
; COMMENTS USE ';' AND CONTAIN NO '=' ON PURPOSE. On Windows cava does not
; use iniparser at all -- config.c's whole Windows branch reads every key
; with GetPrivateProfileString, i.e. the Win32 INI API, which recognises
; only ';' as a comment marker. cava's own shipped config uses '#' and gets
; away with it because those lines happen to contain no '=' and so parse as
; junk; a '#' line WITH an '=' in it would be read as a key. Don't relax
; either rule here.
;
; WHAT IS BEING COPIED. Catppuccin lays down eight stops -- teal, sky,
; sapphire, blue, mauve, pink, maroon, red -- all at one tone, so the ramp
; reads as a pure hue walk from calm at the floor of the bar to hot at the
; peak. That SHAPE is the thing reproduced here. The hues themselves are not,
; and should not be: they are catppuccin's identity, not this desktop's.
;
; WHY THREE STOPS AND NOT EIGHT. matugen synthesises only four distinct
; accent hues from one wallpaper -- primary, secondary, tertiary, error. That
; is the same ceiling already recorded in matugen/templates/palette.lua's
; header, where it forced ANSI magenta to reuse red's hue and ANSI cyan to
; reuse green's rather than invent hues the wallpaper does not contain. Eight
; DISTINCT stops are therefore not available, and padding to eight would mean
; repeating colours -- catppuccin's smoothness would not survive the copy
; anyway.
;
; The fourth hue, `secondary`, is left OUT rather than used. It is the
; wallpaper's own hue desaturated, so as the floor stop it renders a muddy
; grey-cyan across the lower third of the bar -- which is exactly where the
; bars sit most of the time. This was rendered and looked at side by side
; with catppuccin's ramp before being discarded; the version without it is
; both more saturated and closer to the original.
;
; Three is not a loss of smoothness. cava interpolates linearly in RGB
; between consecutive stops, one colour per terminal line
; (output/terminal_noncurses.c, the vertical_gradient block), so three
; anchors render as a continuous sweep, not three bands. Two is cava's own
; floor -- it divides by (gradient_count - 1) -- which is why
; Test-StagedFile's 'cava' case insists on at least two.
;
; THE ORDER, floor of the bar to peak, with the ANSI slot each role also
; paints in WezTerm (see matugen/templates/palette.lua). All three sit at the
; same Material You tone (~80), so this is a pure hue walk at constant
; lightness -- the property that gives catppuccin's ramp its evenness:
;   primary    ansi blue    -- the desktop accent, at full strength, as the
;                             quiet floor. Catppuccin's own floor stop is a
;                             teal of much the same weight.
;   tertiary   ansi cyan    -- Material You's hue-shifted accent, the one
;                             real hue departure a single wallpaper affords.
;   error      ansi red     -- red in every palette matugen builds, whatever
;                             the wallpaper. This is the one stop that stays
;                             fixed like catppuccin's arc instead of
;                             following the image, and it is what keeps the
;                             peak reading as hot rather than as more accent.
;
; Because all four are the exact values WezTerm paints its own ANSI slots
; with, a cava bar and a colourised `ls` in the same window agree by
; construction rather than by coincidence.
;
; NO BACKGROUND KEY, deliberately -- this follows catppuccin's *-transparent
; variant. WezTerm's background is themed from this same palette (and may
; carry opacity), so painting a background here could only disagree with it.
; cava's own requirement is met either way: gradient mode needs background
; defined in hex OR left out entirely.

[color]

; Only consulted if someone turns the gradient off; with gradient = 1 the
; bars are painted from the stops below. Without it that fallback would be
; 'default', which is not a colour at all -- it tells cava to emit no colour
; escape and let the terminal's own foreground stand, which is how the bars
; came out white before any of this existed.
foreground = '#80d4d9'

gradient = 1

gradient_color_1 = '#80d4d9'
gradient_color_2 = '#b5c7e9'
gradient_color_3 = '#ffb4ab'
